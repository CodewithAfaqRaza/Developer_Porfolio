{
  "name": "afaq-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "seo": "node scripts/configure-seo.mjs",
    "test:api": "node --experimental-strip-types --test tests/contact-api.test.ts tests/admin-api.test.ts tests/vercel-api.test.ts",
    "admin:setup": "node scripts/admin-setup.mjs",
    "inquiries:list": "node --experimental-strip-types scripts/contact-data.mjs list",
    "inquiries:delete": "node --experimental-strip-types scripts/contact-data.mjs delete",
    "inquiries:prune": "node --experimental-strip-types scripts/contact-data.mjs prune",
    "secrets:create": "node scripts/init-contact-secrets.mjs",
    "secrets:vercel": "node scripts/init-vercel-secrets.mjs",
    "vercel:config": "node --experimental-strip-types scripts/configure-vercel.mjs",
    "db:migrate": "node --env-file=.env.production.local --experimental-strip-types scripts/migrate-turso.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@libsql/client": "^0.18.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.149.0"
  }
}
