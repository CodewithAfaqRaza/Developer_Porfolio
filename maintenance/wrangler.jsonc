{
  "name": "portfolio-contact-retention",
  "main": "retention-worker.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "triggers": { "crons": ["15 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "portfolio-contact",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }]
}
