# Production on Vercel. This example has no credentials.
# Generate private values with admin:setup -- --production and secrets:vercel.
SITE_ORIGIN=https://YOUR_ACTUAL_PROJECT.vercel.app
TURSO_DATABASE_URL=libsql://YOUR_DATABASE-YOUR_ACCOUNT.turso.io
TURSO_AUTH_TOKEN=YOUR_DATABASE_TOKEN
TURNSTILE_SITE_KEY=YOUR_REAL_PUBLIC_WIDGET_KEY
TURNSTILE_SECRET_KEY=YOUR_REAL_PRIVATE_WIDGET_KEY
DATA_ENCRYPTION_KEY=BASE64_ENCODED_RANDOM_32_BYTE_KEY
RATE_LIMIT_SECRET=RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_PASSWORD_HASH=GENERATED_PRODUCTION_PASSWORD_HASH
CRON_SECRET=RANDOM_SECRET_AT_LEAST_32_CHARACTERS
